# Copy to .env and fill in. NEVER commit .env (it is git-ignored). Placeholders only in THIS file.
# A leaked key is revoked and may affect your submission. Remove debug credentials before you submit.

# --- Orchestration -----------------------------------------------------------
# ORCH_MODE=            # blank: use each agent.json "mode". Or force: inproc | http
# ORCH_FLOW=            # blank: use the flow named in pod.json
# OUT_DIR=out           # where workflow state and evidence are written (workflows/, evidence/)
LOG_LEVEL=INFO          # DEBUG | INFO | WARNING
LOG_FORMAT=json         # json | text

# --- Data --------------------------------------------------------------------
# DATA_DIR=data/sample  # where the organiser stub agents read the Round 2 sample CSVs
# INPUT_DIR=data/input  # per-stage captures: <INPUT_DIR>/<subject_id>/<stage>/<file>

# --- Agent services (only for agents running in http mode) -------------------
# RECEIVING_URL=http://localhost:8101
# PREP_URL=http://localhost:8102
# PACK_URL=http://localhost:8103
# RETURNS_URL=http://localhost:8104
# RECOVERY_URL=http://localhost:8105

# --- Model providers (use whichever your agents use; leave the rest out) -----
# ANTHROPIC_API_KEY=your-key-here
# OPENAI_API_KEY=your-key-here
# GEMINI_API_KEY is no longer used: Receiving, Prep, Pack, Returns and Recovery all use the VLM_* settings below.

# --- Pack Manager (agents/pack) -----------------------------------------------
# Uses the same VLM_API_KEY / VLM_BASE_URL / VLM_MODEL_GROQ as the Returns section below.
# VLM_MAX_IMAGES=3                  # photos per request (Groq's vision model accepts 3); more are sent in groups
# T_PRESENT=0.70                    # Confidence threshold: item presence
# T_COUNT=0.75                      # Confidence threshold: quantity count
# T_EXTRA=0.70                      # Confidence threshold: extra item (confident)
# T_EXTRA_UNSURE=0.35               # Confidence threshold: extra item (uncertain)

# --- Vision model: Receiving, Prep, Pack, Returns and Recovery all share these ---
# Real VLM path only (photos + key). Any OpenAI-compatible endpoint works; the Round 2 default is Groq.
# Without photos the agent replays the sample CSV (labelled "csv-replay"). Photos but no key -> a pending record.
# VLM_API_KEY=your-key-here
# VLM_BASE_URL=https://api.groq.com/openai/v1
# VLM_MODEL_GROQ=your-vision-model-name
# VLM_TIMEOUT_SECONDS=45
# VLM_MAX_RETRIES=2
# Vision cost savers (all on by default; set to 0 to turn one off):
# VLM_CACHE=1                  # reuse the answer to an identical request (model + prompt + image bytes)
# VLM_CACHE_TTL_SECONDS=600
# VLM_CACHE_MAX_ENTRIES=128
# VLM_VALIDATE_IMAGES=1        # refuse an empty / corrupt image before calling the API
# VLM_LOG_USAGE=1              # one log line per call: cache hit/miss + API usage (needs LOG_LEVEL=INFO to show)
