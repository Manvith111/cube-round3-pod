# Copy to .env and fill in. NEVER commit .env (it is git-ignored). Placeholders only in THIS file.
# A leaked key is revoked and may affect your submission. Remove debug credentials before you submit.

# --- Orchestration -----------------------------------------------------------
# ORCH_MODE=            # blank: use each agent.json "mode". Or force: inproc | http
# ORCH_FLOW=            # blank: use the flow named in pod.json
# OUT_DIR=out           # where workflow state and evidence are written (workflows/, evidence/)
LOG_LEVEL=INFO          # DEBUG | INFO | WARNING
LOG_FORMAT=json         # json | text

# --- Data --------------------------------------------------------------------
# DATA_DIR=data/sample  # where the organiser stub agents read the Round 2 sample CSVs
# INPUT_DIR=data/input  # per-stage captures: <INPUT_DIR>/<subject_id>/<stage>/<file>

# --- Agent services (only for agents running in http mode) -------------------
# RECEIVING_URL=http://localhost:8101
# PREP_URL=http://localhost:8102
# PACK_URL=http://localhost:8103
# RETURNS_URL=http://localhost:8104
# RECOVERY_URL=http://localhost:8105

# --- Model providers (use whichever your agents use; leave the rest out) -----
# ANTHROPIC_API_KEY=your-key-here
# OPENAI_API_KEY=your-key-here
GEMINI_API_KEY=your-key-here
# MODEL_NAME=

# --- Pack Manager (agents/pack) -----------------------------------------------
# VLM_MODEL=gemini-2.5-flash       # Gemini model for pack-audit vision calls
# VLM_TIMEOUT_MS=20000              # Per-call timeout in milliseconds
# T_PRESENT=0.70                    # Confidence threshold: item presence
# T_COUNT=0.75                      # Confidence threshold: quantity count
# T_EXTRA=0.70                      # Confidence threshold: extra item (confident)
# T_EXTRA_UNSURE=0.35               # Confidence threshold: extra item (uncertain)

# --- Storage Architecture (Local & Remote) -----------------------------------
# By default, all immutable workflow evidence, outputs, and images are stored locally:
#   - Images / Verification Captures: data/input/<subject_id>/<stage>/<filename>
#   - Immutable Evidence Records:     out/evidence/<record_id>.json
#   - Workflow State:                 out/workflows/<workflow_id>.json
#   - Full Run History Audit Logs:    out/history/<workflow_id>_<timestamp>.json
#
# OUT_DIR=out           # Root directory where workflow state, evidence and history are written
# INPUT_DIR=data/input  # Per-stage captures: <INPUT_DIR>/<subject_id>/<stage>/<file>
#
# Optional Supabase / Remote Storage Integration (if migrating from local FileStore):
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# SUPABASE_STORAGE_BUCKET=commerce-evidence-captures
